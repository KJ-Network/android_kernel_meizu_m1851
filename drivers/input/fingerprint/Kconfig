config INPUT_FINGERPRINT
	tristate "Fingerprint driver support"
	help
	  Say Y here to enable fingerprint driver support.

if INPUT_FINGERPRINT
    menu "Fingerprint sensors"
config FINGERPRINT_ID
	bool "Fingerprint sensor selector"
	depends on OF && GPIOLIB
	help
	  Selects the Goodix or ET512 sensor using the board fingerprint ID
	  GPIO and keeps the shared selector GPIO owned by one driver.

        source "drivers/input/fingerprint/goodix/Kconfig"
        source "drivers/input/fingerprint/et512/Kconfig"
    endmenu
endif
